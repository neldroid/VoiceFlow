# Copy this file to `local.properties` and fill in the values for your machine.
# `local.properties` is generated by Android Studio and is gitignored.

# Path to the Android SDK (Android Studio sets this automatically).
sdk.dir=/path/to/Android/Sdk

# Base URL of the backend the app talks to. Exposed as BuildConfig.BASE_URL.
# Defaults to the Android emulator loopback when not set.
BASE_URL=http://10.0.2.2:8000
